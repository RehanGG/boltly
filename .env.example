NEXT_PUBLIC_SITE_URL=https://boltly.io
NEXT_PUBLIC_SITE_NAME=Boltly
# Google Analytics 4 measurement ID, like G-XXXXXXXXXX. Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=
# AdSense is switched off for now (see src/lib/thirdparty.ts). To use it later, restore these:
# NEXT_PUBLIC_ADSENSE_CLIENT=   (publisher ID, like ca-pub-1234567890123456)
# NEXT_PUBLIC_ADSENSE_SLOT=     (ad unit ID, digits)
# Address shown on the Contact and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@boltly.io
