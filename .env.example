NEXT_PUBLIC_SITE_URL=https://boltly.io
NEXT_PUBLIC_SITE_NAME=Boltly
# Google Analytics 4 measurement ID, like G-XXXXXXXXXX. Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=
# AdSense publisher ID, like ca-pub-1234567890123456. Leave empty to turn ads off.
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense ad unit ID (digits) used for the ad slots. Ads only show when this is set too.
NEXT_PUBLIC_ADSENSE_SLOT=
# Address shown on the Contact and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=hello@boltly.io
